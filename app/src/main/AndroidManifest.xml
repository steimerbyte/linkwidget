<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET wird fuer das Laden des Favicons der vom Benutzer
        eingegebenen Website benoetigt. Es werden ausschliesslich die
        Icon-URLs dieser Websites abgerufen - keine Analytics, kein
        Tracking, keine Weitergabe an Dritte.

        Gespeichert wird nur in den privaten App-Bereichen
        (SharedPreferences und Cache).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkWidget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/config_title"
            android:theme="@style/Theme.LinkWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            Der Receiver muss exportiert sein: der Launcher sendet
            APPWIDGET_UPDATE. Die eigene Action OPEN_LINK wird
            dagegen nur ueber den eigenen PendingIntent ausgeloest
            (FLAG_IMMUTABLE) und ist hier bewusst NICHT registriert.

            Wuerde sie registriert und exportiert bleiben, koennte
            jede App auf dem Geraet einen Broadcast senden und einen
            beliebigen gespeicherten Link oeffnen lassen. Sie steht
            deshalb in keinem intent-filter, sondern wird in
            onReceive direkt behandelt - dort erreicht sie nur ein
            Intent, den die App selbst erzeugt hat.
        -->
        <receiver
            android:name=".LinkWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/link_widget_info" />
        </receiver>
    </application>

</manifest>
