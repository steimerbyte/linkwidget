<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing-Charakter: feines Punktraster auf Schwarz.
    Der Layer-List zeichnet die Punkte als 1dp-Kreise in einem 8dp-Raster.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nothing_black" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/nothing_outline" />
        </shape>
    </item>

</layer-list>
