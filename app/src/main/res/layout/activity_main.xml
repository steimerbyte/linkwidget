<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.4"
            android:text="●"
            android:textColor="@color/nothing_dim"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="2dp"
            android:text="@string/main_headline"
            android:textColor="@color/nothing_white"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="@string/main_sub"
            android:textColor="@color/nothing_grey"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/nothing_outline" />

        <EditText
            android:id="@+id/input_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/input_background"
            android:fontFamily="monospace"
            android:hint="@string/hint_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="@color/nothing_white"
            android:textColorHint="@color/nothing_dim"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/input_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_background"
            android:fontFamily="sans-serif"
            android:hint="@string/hint_title"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/nothing_white"
            android:textColorHint="@color/nothing_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_test"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_background"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/button_test"
            android:textAllCaps="false"
            android:textColor="@color/nothing_black"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_add_widget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_background_outline"
            android:fontFamily="monospace"
            android:text="@string/button_add_widget"
            android:textAllCaps="false"
            android:textColor="@color/nothing_white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="GESPEICHERTE LINKS"
            android:textColor="@color/nothing_dim"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/link_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
