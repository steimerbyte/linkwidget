<?xml version="1.0" encoding="utf-8"?>
<!--
    Das Favicon ist das Hauptelement. Der Text ist Beiwerk:
    Titel darunter, URL klein und nur wenn ein eigener Titel gesetzt
    ist - sonst wuerde die Adresse doppelt erscheinen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_icon_desc"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.35"
        android:text="●"
        android:textColor="@color/nothing_dim"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:textColor="@color/nothing_white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/nothing_grey"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:text="@string/widget_hint"
        android:textColor="@color/nothing_dim"
        android:textSize="8sp" />

</LinearLayout>
