<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nothing_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.4"
            android:text="●"
            android:textColor="@color/nothing_dim"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/config_title"
            android:textColor="@color/nothing_white"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/input_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/input_background"
            android:fontFamily="monospace"
            android:hint="@string/hint_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="@color/nothing_white"
            android:textColorHint="@color/nothing_dim"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/input_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_background"
            android:fontFamily="sans-serif"
            android:hint="@string/hint_title"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/nothing_white"
            android:textColorHint="@color/nothing_dim"
            android:textSize="14sp" />

        <!--
            Abruf-Button mit Live-Vorschau und Terminal-Ausgabe.

            Die Ausgabe enthaelt jeden Schritt des Abrufs: Umgebung,
            DNS, HTTP-Status, erkanntes Format, Groesse. Wenn der
            Abruf scheitert, steht hier der konkrete Grund statt
            einer Meldung wie "nichts gefunden".
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_background"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/preview_image"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/widget_icon_desc"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="@string/preview_label"
                    android:textColor="@color/nothing_dim"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/preview_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="@string/fetch_hint"
                    android:textColor="@color/nothing_grey"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/button_copy_log"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/button_background_outline"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:minWidth="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/button_copy_log"
                    android:textAllCaps="false"
                    android:textColor="@color/nothing_grey"
                    android:textSize="11sp" />

            </LinearLayout>

            <Button
                android:id="@+id/button_fetch"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_background_outline"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="@string/button_fetch"
                android:textAllCaps="false"
                android:textColor="@color/nothing_white"
                android:textSize="13sp" />

            <!--
                Terminal-Ausgabe. Die Zeilen werden waehrend des
                Abrufs einzeln angehaengt, damit der Verlauf lesbar
                bleibt und nicht am Ende alles auf einmal erscheint.
            -->
            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="#000000"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="10dp"
                    android:text="@string/log_hint"
                    android:textColor="@color/nothing_grey"
                    android:textColorHint="@color/nothing_dim"
                    android:textIsSelectable="true"
                    android:textSize="10sp" />

            </ScrollView>

        </LinearLayout>

        <!--
            Anzeigeoptionen fuer dieses Widget. Beide Schalter wirken
            sofort: das Widget wird neu gezeichnet, ohne dass gespeichert
            werden muss.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_background"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="@string/display_label"
                android:textColor="@color/nothing_dim"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toggle_show_title"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toggle_show_url"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toggle_show_dot"
                    android:textColor="@color/nothing_white"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/toggle_hint"
                android:textColor="@color/nothing_dim"
                android:textSize="11sp" />

        </LinearLayout>

        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_background"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/button_save"
            android:textAllCaps="false"
            android:textColor="@color/nothing_black"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_cancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_background_outline"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="@string/button_cancel"
            android:textAllCaps="false"
            android:textColor="@color/nothing_white"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
